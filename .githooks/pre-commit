#!/bin/sh
#
# 提交前的完整自检
#
# 为什么跑整套而不只是扫暂存区：
#   1. 工作区里可能有未跟踪的本机状态文件（.wrangler/ 等）——
#      它们不在暂存区，但迟早会被 `git add -A` 带进去
#   2. 提交信息本身也是公开的，且永久留在 git 历史里
#   3. 历史里可能已经有漏网之鱼
#
# 想跳过：git commit --no-verify
# （但 CI 那层挡不住 —— 服务器端每次 push 都会跑）
#
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! command -v node >/dev/null 2>&1; then
  echo "⚠ 跳过敏感信息检查（未找到 node）"
  exit 0
fi

exec node scripts/preflight.js --staged
